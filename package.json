{
  "type": "module",
  "scripts": {
    "db:build": "node backend/pipeline/buildGraph.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:all": "docker compose -f docker-compose.test.yml run --rm all-tests"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "neo4j-driver": "^6.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "babel-jest": "^30.3.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "moduleNameMapper": {
      "^next/server$": "<rootDir>/backend/tests/test-mocks/next-server.js"
    },
    "testMatch": [
      "<rootDir>/backend/tests/**/*.test.js"
    ],
    "testEnvironment": "node",
    "transform": {}
  }
}
